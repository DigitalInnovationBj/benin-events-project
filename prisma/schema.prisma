generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum PaymentProvider {
  FEEXPAY
  GENIUSPAY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  IN_PERSON
  ONLINE
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  /// Lot de billets imprimés pour la vente en point de vente. Ses billets
  /// réservent du stock mais ne comptent comme vendus qu'une fois activés
  /// (OrderItem.activatedAt) ; la commande reste hors des recettes en ligne,
  /// des reversements et des emails.
  PRINTED
}

enum AgentStatus {
  PENDING
  CONFIRMED
  REVOKED
}

enum PlatformPaymentType {
  EVENT_CREATION
  EVENT_FEATURED
}

enum PlatformPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutMethodType {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum MobileMoneyOperator {
  MTN
  MOOV
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

/// Ordre d'affichage des billets sur la page publique d'un évènement.
enum TicketSort {
  PRICE_ASC
  PRICE_DESC
  CUSTOM
}

enum TicketTemplate {
  PRIMARY
  SECONDARY
}

enum CampaignStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  emailVerified     Boolean            @default(false)
  image             String?
  role              Role               @default(USER)

  // Consentement newsletter (digests lundi/mercredi/vendredi)
  newsletterOptIn   Boolean            @default(true)

  // Programme Partenaire Bénin Events — taux de commission négocié (remplace
  // PlatformSettings.commissionRate pour cet organisateur si renseigné)
  partnerCommissionRate Float?

  // Plugin admin better-auth — comptes créés directement par un admin
  // (organisateurs validés à la main). banned/banReason/banExpires ne sont
  // pas utilisés activement dans l'app, requis par le schéma du plugin.
  banned            Boolean?           @default(false)
  banReason         String?
  banExpires        DateTime?

  sessions          Session[]
  accounts          Account[]

  organizerRequests OrganizerRequest[]
  partnerRequests   PartnerRequest[]
  events            Event[]
  likes             Like[]
  favorites         Favorite[]
  orders            Order[]
  agentFor          EventAgent[]
  payoutMethod      PayoutMethod?
  payoutRequests    PayoutRequest[]    @relation("OrganizerPayouts")
  platformPayments  PlatformPayment[]
  campaigns         EventCampaign[]
  /// Billets imprimés activés (vendus) par cet utilisateur en point de vente.
  activatedTickets  OrderItem[]        @relation("TicketActivations")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ─────────────────────────────────────────────
// Auth (better-auth)
// ─────────────────────────────────────────────

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Plugin admin better-auth — non utilisé activement (pas d'impersonation
  /// dans l'app), requis par le schéma du plugin.
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model OrganizerRequest {
  id             String        @id @default(cuid())
  organizerName  String
  organizerEmail String?
  phoneNumber    String
  address        String
  description    String?
  status         RequestStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Candidature au programme "Partenaire Bénin Events" — formulaire dédié,
/// distinct de OrganizerRequest, validé par un admin qui fixe le taux de
/// commission négocié (User.partnerCommissionRate) à l'approbation.
model PartnerRequest {
  id                     String        @id @default(cuid())
  organizationName       String
  sector                 String
  estimatedEventsPerYear Int
  message                String?       @db.Text
  status                 RequestStatus @default(PENDING)
  adminNote              String?

  applicantId String
  applicant   User   @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Catégories
// ─────────────────────────────────────────────

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  events EventCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Table de jointure Event <-> Category (many-to-many)
model EventCategory {
  eventId    String
  categoryId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
}

// ─────────────────────────────────────────────
// Événement
// ─────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text

  /// Habillage personnalisé de la page publique et des billets PDF (ex.
  /// « adjatche »). Null = gabarit Benin Events par défaut. Les clés valides
  /// sont déclarées dans src/themes/registry.ts.
  theme       String?

  /// Ordre d'affichage des billets (prix croissant par défaut ; CUSTOM suit
  /// Ticket.position, réglé par glisser-déposer dans le dashboard).
  ticketSort  TicketSort @default(PRICE_ASC)

  // Type d'évènement
  eventType   EventType @default(IN_PERSON)

  /// Obligatoire pour les événements en présentiel — adresse libre.
  location    String?

  /// Ville normalisée (slug, ex. "cotonou"), dérivée de `location` à la
  /// saisie. `location` reste du texte libre : ce champ existe pour filtrer et
  /// compter de façon fiable, ce que le `contains` sur `location` ne permet pas.
  city        String?

  /// Obligatoire pour les événements en ligne (validé côté applicatif) —
  /// n'est plus affiché publiquement, seulement aux acheteurs de billet.
  onlineUrl   String?

  /// Message libre (texte riche) envoyé aux acheteurs après paiement —
  /// lien de groupe WhatsApp, instructions d'accès, stationnement, etc.
  /// Disponible pour tous les types d'évènement, pas seulement en ligne.
  postPurchaseMessage String? @db.Text

  startDate   DateTime
  endDate     DateTime

  // Mise en vedette (décidé par l'admin ou payé par l'organisateur)
  isFeatured  Boolean  @default(false)

  // Publication (false = en attente de paiement de création)
  isPublished Boolean  @default(true)

  // Suppression douce (soft delete)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  // Annulation par l'organisateur ou l'admin (évènement maintenu, non supprimé,
  // mais dépublié — les commandes payées sont à rembourser)
  isCancelled Boolean  @default(false)
  cancelledAt DateTime?
  cancellationReason String? @db.Text

  // Interactions — compteur de partages (likes & favoris via relations dédiées)
  shareCount  Int      @default(0)

  // Images (Vercel Blob)
  imageUrl    String?

  // SEO & Social Media (OG Tags)
  ogTitle     String?
  ogImage     String?

  /// Titre + description (HTML retiré) + lieu, en minuscules sans accents.
  /// Alimenté à l'enregistrement (cf. src/lib/search.ts) : comparer la saisie
  /// aux champs bruts faisait échouer la recherche sur les accents et la casse.
  searchText  String? @db.Text

  // Relations
  organizerId String
  organizer   User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  tickets          Ticket[]
  /// Sessions à accès restreint (conférences…), scannées à part.
  sessions         EventSession[]
  categories       EventCategory[]
  likes            Like[]
  favorites        Favorite[]
  orders           Order[]
  agents           EventAgent[]
  platformPayments PlatformPayment[]
  campaigns        EventCampaign[]
  partners         EventPartner[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([startDate])
}

// ─────────────────────────────────────────────
// Interactions utilisateur
// ─────────────────────────────────────────────

/// Un utilisateur ne peut liker un événement qu'une seule fois
model Like {
  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

/// Un utilisateur ne peut mettre en favori un événement qu'une seule fois
model Favorite {
  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ─────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────

model Ticket {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Float
  imageUrl    String?

  // Options de stock
  totalStock  Int?

  // Template du billet PDF joint à l'email de confirmation
  emailTemplate TicketTemplate @default(PRIMARY)

  /// Jours de validité d'un pass multi-jours, au format « YYYY-MM-DD » (fuseau
  /// Africa/Porto-Novo). Vide = billet classique à scan unique : comportement
  /// historique inchangé. Renseigné = un scan autorisé par jour listé.
  validDays String[] @default([])

  /// Retiré de la vente : masqué sur le site et non achetable, mais ses
  /// commandes et QR codes restent valides. Posé à la place d'une suppression
  /// quand le billet a déjà des commandes.
  isArchived Boolean @default(false)

  /// Rang du billet quand l'évènement est en ordre personnalisé (0 = premier).
  position   Int     @default(0)

  /// Sessions de l'évènement auxquelles ce billet donne accès (ex. les
  /// conférences du festival pour le pass VVIP).
  sessions TicketSession[]

  /// Visuels du graphiste pour les billets imprimés (151 × 56 mm, fond perdu
  /// compris). Null = design Benin Events par défaut.
  printFrontUrl String?
  printBackUrl  String?

  // Relations
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Commandes & Paiements
// ─────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float

  // Paiement FeexPay (Mobile Money) — providerReference = référence FeexPay,
  // utile pour le support/status-check ; payerPhone/payerNetwork = saisis
  // par l'acheteur à l'initiation (numéro + opérateur mobile money).
  providerReference String? @unique
  payerPhone        String?
  payerNetwork      String?

  /// Prestataire du paiement : FeexPay (Mobile Money) ou GeniusPay (carte).
  paymentProvider PaymentProvider @default(FEEXPAY)
  /// Frais de paiement ajoutés au prix payé par l'acheteur (carte). Le
  /// montant débité est totalAmount + paymentFee ; totalAmount reste la
  /// recette des billets (reversements, statistiques).
  paymentFee      Float           @default(0)

  // Acheteur authentifié (null pour les commandes invité)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Informations acheteur invité (non authentifié)
  guestEmail String?
  guestName  String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Code promo partenaire (influenceur) éventuellement appliqué
  eventPartnerId String?
  eventPartner   EventPartner? @relation(fields: [eventPartnerId], references: [id], onDelete: SetNull)
  discountAmount Float         @default(0)

  items OrderItem[]

  /// Livraison des billets par email. Sans cette trace, un envoi Resend en
  /// échec laissait une commande payée dont l'acheteur ne recevait rien, sans
  /// aucun moyen de le détecter ni de renvoyer les billets.
  ticketsSentAt    DateTime?
  ticketsSendError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([eventId])
  @@index([eventPartnerId])
}

/// Partenaire d'un évènement (ex: influenceur) — code promo géré par
/// l'organisateur. La commission/rétribution du partenaire est négociée et
/// versée hors plateforme ; on se contente d'attribuer les ventes au code.
model EventPartner {
  id            String       @id @default(cuid())
  name          String
  code          String
  discountType  DiscountType
  discountValue Float
  isActive      Boolean      @default(true)

  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, code])
}

model OrderItem {
  id             String    @id @default(cuid())
  quantity       Int
  price          Float
  scannedCount   Int       @default(0)
  firstScannedAt DateTime?

  // Participant nommé (optionnel — utilisé quand l'acheteur achète pour quelqu'un d'autre)
  attendeeName  String?
  attendeeEmail String?

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  /// Scans par jour — utilisé uniquement pour les billets multi-jours
  /// (`Ticket.validDays` non vide).
  scans TicketScan[]

  /// Billet imprimé (commande PRINTED) : numéro dans la série du billet
  /// (VVIP-0001…), puis activation par le point de vente qui l'a vendu. Un
  /// billet imprimé non activé est refusé à l'entrée.
  serial        Int?
  activatedAt   DateTime?
  activatedById String?
  activatedBy   User?     @relation("TicketActivations", fields: [activatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([ticketId, serial])
  @@index([attendeeEmail])
  @@index([activatedById])
}

/// Un scan validé, enregistré par jour et par point de contrôle : l'entrée
/// générale (« main », billets multi-jours) ou une session (son id). La
/// contrainte d'unicité empêche deux passages le même jour au même point,
/// même si deux agents scannent au même instant.
model TicketScan {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Évènement dont l'agent a scanné le billet.
  eventId String

  /// Point de contrôle : « main » (entrée générale) ou l'id d'une EventSession.
  checkpoint String @default("main")

  /// Jour du scan, « YYYY-MM-DD » (fuseau Africa/Porto-Novo).
  day       String
  scannedAt DateTime @default(now())

  @@unique([orderItemId, day, checkpoint])
}

// ─────────────────────────────────────────────
// Reversements
// ─────────────────────────────────────────────

model PayoutMethod {
  id          String               @id @default(cuid())
  type        PayoutMethodType
  operator    MobileMoneyOperator?
  phoneNumber String?
  bankName    String?
  accountName String?
  iban        String?

  userId      String               @unique
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model PayoutRequest {
  id               String               @id @default(cuid())
  grossAmount      Float
  commissionRate   Float
  commissionAmount Float
  netAmount        Float
  status           PayoutStatus         @default(PENDING)
  adminNote        String?

  // Snapshot des coordonnées au moment de la demande
  methodType       PayoutMethodType
  operator         MobileMoneyOperator?
  phoneNumber      String?
  bankName         String?
  accountName      String?
  iban             String?

  organizerId      String
  organizer        User                 @relation("OrganizerPayouts", fields: [organizerId], references: [id])

  processedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organizerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Paramètres plateforme
// ─────────────────────────────────────────────

model PlatformSettings {
  id                      String   @id @default("singleton")
  commissionRate          Float    @default(0)
  eventCreationFeeEnabled Boolean  @default(false)
  eventCreationFee        Float    @default(5000)
  featuredEventFeeEnabled Boolean  @default(false)
  featuredEventFee        Float    @default(5000)
  updatedAt               DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Paiements plateforme (création d'évènement, mise en vedette)
// ─────────────────────────────────────────────

model PlatformPayment {
  id          String                @id @default(cuid())
  type        PlatformPaymentType
  status      PlatformPaymentStatus @default(PENDING)
  amount      Float

  // Paiement FeexPay (Mobile Money) — voir Order pour le détail des champs.
  providerReference String? @unique
  payerPhone        String?
  payerNetwork      String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Agents d'évènement
// ─────────────────────────────────────────────

model EventAgent {
  id     String      @id @default(cuid())
  token  String      @unique
  status AgentStatus @default(PENDING)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Rôles : contrôle d'entrée (historique, par défaut) et/ou point de vente
  /// (activation des billets imprimés).
  canScan Boolean @default(true)
  canSell Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([token])
}

// ─────────────────────────────────────────────
// Campagnes email (organisateur → visibilité évènement)
// ─────────────────────────────────────────────

model EventCampaign {
  id      String         @id @default(cuid())
  subject String
  message String         @db.Text
  status  CampaignStatus @default(PENDING)

  /// Cible les utilisateurs de la plateforme ayant newsletterOptIn = true
  targetPlatformUsers Boolean  @default(true)
  /// Adresses externes fournies par l'organisateur (collées ou importées CSV/XLSX)
  externalEmails      String[]

  recipientCount Int @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId])
}

/// Adresses externes ayant demandé à ne plus recevoir de campagnes
/// (n'ont jamais opt-in sur la plateforme, donc pas couvertes par User.newsletterOptIn)
model CampaignSuppression {
  email     String   @id
  createdAt DateTime @default(now())
}

/// Session à accès restreint d'un évènement (ex. « Conférences » le 18 déc.).
/// Seuls les billets liés (TicketSession) y sont acceptés, une fois.
model EventSession {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  /// Jour de la session, « YYYY-MM-DD » (fuseau Africa/Porto-Novo).
  day      String
  /// Nombre maximal d'entrées (null = sans limite).
  capacity Int?

  tickets TicketSession[]

  createdAt DateTime @default(now())

  @@index([eventId])
}

/// Accès d'un billet à une session.
model TicketSession {
  ticketId  String
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sessionId String
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([ticketId, sessionId])
  @@index([sessionId])
}
