generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  IN_PERSON
  ONLINE
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AgentStatus {
  PENDING
  CONFIRMED
  REVOKED
}

enum PlatformPaymentType {
  EVENT_CREATION
  EVENT_FEATURED
}

enum PlatformPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutMethodType {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum MobileMoneyOperator {
  MTN
  MOOV
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum TicketTemplate {
  PRIMARY
  SECONDARY
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  clerkId           String             @unique
  email             String             @unique
  name              String?
  image             String?
  role              Role               @default(USER)

  organizerRequests OrganizerRequest[]
  events            Event[]
  likes             Like[]
  favorites         Favorite[]
  orders            Order[]
  agentFor          EventAgent[]
  payoutMethod      PayoutMethod?
  payoutRequests    PayoutRequest[]    @relation("OrganizerPayouts")
  platformPayments  PlatformPayment[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clerkId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model OrganizerRequest {
  id             String        @id @default(cuid())
  organizerName  String
  organizerEmail String?
  phoneNumber    String
  address        String
  description    String?
  status         RequestStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Catégories
// ─────────────────────────────────────────────

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  events EventCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Table de jointure Event <-> Category (many-to-many)
model EventCategory {
  eventId    String
  categoryId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
}

// ─────────────────────────────────────────────
// Événement
// ─────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text

  // Type d'évènement
  eventType   EventType @default(IN_PERSON)

  /// Obligatoire pour les événements en présentiel
  location    String?

  /// Obligatoire pour les événements en ligne (validé côté applicatif)
  onlineUrl   String?

  startDate   DateTime
  endDate     DateTime

  // Mise en vedette (décidé par l'admin ou payé par l'organisateur)
  isFeatured  Boolean  @default(false)

  // Publication (false = en attente de paiement de création)
  isPublished Boolean  @default(true)

  // Suppression douce (soft delete)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  // Interactions — compteur de partages (likes & favoris via relations dédiées)
  shareCount  Int      @default(0)

  // Images (Vercel Blob)
  imageUrl    String?

  // SEO & Social Media (OG Tags)
  ogTitle     String?
  ogImage     String?

  // Relations
  organizerId String
  organizer   User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  tickets          Ticket[]
  categories       EventCategory[]
  likes            Like[]
  favorites        Favorite[]
  orders           Order[]
  agents           EventAgent[]
  platformPayments PlatformPayment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Interactions utilisateur
// ─────────────────────────────────────────────

/// Un utilisateur ne peut liker un événement qu'une seule fois
model Like {
  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

/// Un utilisateur ne peut mettre en favori un événement qu'une seule fois
model Favorite {
  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ─────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────

model Ticket {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Float
  imageUrl    String?

  // Options de stock
  totalStock  Int?

  // Template du billet PDF joint à l'email de confirmation
  emailTemplate TicketTemplate @default(PRIMARY)

  // Relations
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Commandes & Paiements
// ─────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float

  geniuspayId Int?
  checkoutUrl String?

  // Acheteur authentifié (null pour les commandes invité)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Informations acheteur invité (non authentifié)
  guestEmail String?
  guestName  String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([eventId])
}

model OrderItem {
  id             String    @id @default(cuid())
  quantity       Int
  price          Float
  scannedCount   Int       @default(0)
  firstScannedAt DateTime?

  // Participant nommé (optionnel — utilisé quand l'acheteur achète pour quelqu'un d'autre)
  attendeeName  String?
  attendeeEmail String?

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  createdAt DateTime @default(now())

  @@index([attendeeEmail])
}

// ─────────────────────────────────────────────
// Reversements
// ─────────────────────────────────────────────

model PayoutMethod {
  id          String               @id @default(cuid())
  type        PayoutMethodType
  operator    MobileMoneyOperator?
  phoneNumber String?
  bankName    String?
  accountName String?
  iban        String?

  userId      String               @unique
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model PayoutRequest {
  id               String               @id @default(cuid())
  grossAmount      Float
  commissionRate   Float
  commissionAmount Float
  netAmount        Float
  status           PayoutStatus         @default(PENDING)
  adminNote        String?

  // Snapshot des coordonnées au moment de la demande
  methodType       PayoutMethodType
  operator         MobileMoneyOperator?
  phoneNumber      String?
  bankName         String?
  accountName      String?
  iban             String?

  organizerId      String
  organizer        User                 @relation("OrganizerPayouts", fields: [organizerId], references: [id])

  processedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organizerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Paramètres plateforme
// ─────────────────────────────────────────────

model PlatformSettings {
  id                      String   @id @default("singleton")
  commissionRate          Float    @default(0)
  eventCreationFeeEnabled Boolean  @default(false)
  eventCreationFee        Float    @default(5000)
  featuredEventFeeEnabled Boolean  @default(false)
  featuredEventFee        Float    @default(5000)
  updatedAt               DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Paiements plateforme (création d'évènement, mise en vedette)
// ─────────────────────────────────────────────

model PlatformPayment {
  id          String                @id @default(cuid())
  type        PlatformPaymentType
  status      PlatformPaymentStatus @default(PENDING)
  amount      Float

  geniuspayId Int?
  checkoutUrl String?
  reference   String?               @unique

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Agents d'évènement
// ─────────────────────────────────────────────

model EventAgent {
  id     String      @id @default(cuid())
  token  String      @unique
  status AgentStatus @default(PENDING)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([token])
}
